# PLZ oder Ort, von dem aus der Radius berechnet wird
HOME_LOCATION=45657
# Umkreis in Kilometern
RADIUS_KM=40
# Remote-Jobs unabhängig vom Radius immer anzeigen
INCLUDE_REMOTE=true

# Kommagetrennte Stichwörter, die im Jobtitel (Arbeitnow) bzw. Titel+Beschreibung (Adzuna) vorkommen müssen
KEYWORDS=junior developer,junior software,junior softwareentwickler,junior programmierer,junior fullstack,junior full-stack,junior backend,junior frontend,junior web developer,junior it,fachinformatiker anwendungsentwicklung,trainee software,trainee developer,werkstudent softwareentwickl,werkstudent developer

# Wie oft automatisch neue Jobs geladen werden (Minuten)
FETCH_INTERVAL_MINUTES=60

# Kostenlosen API-Key holen: https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=de
# Kommagetrennte Suchbegriffe, jeder verbraucht einen eigenen API-Request pro Fetch
ADZUNA_QUERIES=junior

DATABASE_URL=sqlite:///./data/jobs.db
