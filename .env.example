# Postal code or city the radius is calculated from
HOME_LOCATION=45657
# Search radius in kilometers
RADIUS_KM=40
# Always show remote jobs regardless of radius
INCLUDE_REMOTE=true

# Comma-separated keywords that must appear in the job title (Arbeitnow) or title+description (Adzuna)
KEYWORDS=junior developer,junior software,junior softwareentwickler,junior programmierer,junior fullstack,junior full-stack,junior backend,junior frontend,junior web developer,junior it,fachinformatiker anwendungsentwicklung,trainee software,trainee developer,werkstudent softwareentwickl,werkstudent developer

# How often new jobs are fetched automatically (minutes)
FETCH_INTERVAL_MINUTES=60

# Get a free API key: https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=de
# Comma-separated search queries; each one uses a separate API request per fetch
ADZUNA_QUERIES=junior

DATABASE_URL=sqlite:///./data/jobs.db
